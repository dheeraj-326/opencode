{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "allow",
        "external_directory": {
            "~/.config/opencode/**": "allow"
        }
    },
    "plugin": [
        "./plugins/command-review.ts"
    ],
    "mcp": {
        "roam-code": {
            "type": "local",
            "enabled": true,
            "command": ["roam", "mcp"],
            "environment": {
                "ROAM_MCP_PRESET": "full"
            }
        },
        "crawl4ai": {
            "type": "local",
            "command": ["uvx", "crawl-mcp"],
            "enabled": true
        }
    }
}